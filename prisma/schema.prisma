enum ApplicationStatus {
  PENDING // Aguardando análise
  UNDER_REVIEW // Em revisão manual
  APPROVED
  REJECTED
  REVOKED // Aprovação revogada (fraude posterior)
}

model ClipperApplication {
  id               String            @id @default(cuid())
  campaignId       String
  clipperProfileId String
  status           ApplicationStatus @default(PENDING)

  // Dados da aplicação (snapshot do formulário)
  formData Json

  // Análise automática
  autoScore    Float?
  autoFlags    Json? // Flags automáticas encontradas
  autoDecision String? // "APPROVE", "REJECT", "MANUAL_REVIEW"

  // Revisão manual
  reviewedBy      String?
  reviewedAt      DateTime?
  reviewNotes     String?
  rejectionReason String?

  approvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Relações
  campaign              Campaign                   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  clipperProfile        ClipperProfile             @relation(fields: [clipperProfileId], references: [id], onDelete: Cascade)
  clipPosts             ClipPost[]
  socialAccounts        ApplicationSocialAccount[] // Contas sociais usadas nesta inscrição
  monthlyRankingEntries MonthlyRankingEntry[] // Entradas em rankings mensais
  dailyRankingEntries   DailyRankingEntry[] // Entradas em rankings diários

  @@unique([campaignId, clipperProfileId])
  @@index([campaignId])
  @@index([clipperProfileId])
  @@index([clipperProfileId, status])
  @@index([status])
  @@index([createdAt])
  @@index([campaignId, status]) // Contagens de participantes por campanha+status
}

// ============================================================================
// CONTAS SOCIAIS USADAS EM APPLICATIONS
// ============================================================================

model ApplicationSocialAccount {
  id            String   @id @default(cuid())
  applicationId String
  accountId     String
  createdAt     DateTime @default(now())

  // Relações
  application   ClipperApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([applicationId, accountId]) // Uma conta pode ser usada apenas uma vez por application
  @@index([applicationId])
  @@index([accountId])
}

// ============================================================================
// CLIP POSTS (VÍDEOS ENVIADOS)
