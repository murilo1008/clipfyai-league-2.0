  username   String // @username ou handle
  profileUrl String? // URL completa do perfil

  // Nicho da conta
  niche AccountNiche?

  // Flags
  isPrimary  Boolean @default(false) // Conta principal do clipador
  isVerified Boolean @default(false) // Verificada pela plataforma
  isActive   Boolean @default(true) // Conta ativa/usada

  // Métricas (opcional - pode ser preenchido depois)
  followers         Int? // Número de seguidores
  avgViews          Int? // Média de visualizações
  avgEngagementRate Float? // Taxa de engajamento média
  lastCheckedAt     DateTime? // Última verificação das métricas

