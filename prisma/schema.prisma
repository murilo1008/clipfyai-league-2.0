enum FailureStatus {
  OPEN // Falha ainda não resolvida
  RESOLVED // Falha foi resolvida (post foi extraído com sucesso depois)
  IGNORED // Falha foi ignorada (post deletado, etc)
}

model MetricsExtractionFailure {
  id                String        @id @default(cuid())
  clipPostId        String // ID do post que falhou
  campaignId        String? // Para facilitar queries por campanha
  platform          Platform // INSTAGRAM, TIKTOK, FACEBOOK, YOUTUBE, KWAI
  platformPostId    String // URL ou ID do post na plataforma
  // Dados do job BullMQ
  jobId             String? // ID do job BullMQ para referência
  attemptsMade      Int           @default(2) // Quantas tentativas foram feitas
  maxAttempts       Int           @default(2) // Total de tentativas configuradas
  // Erro
  errorMessage      String // Mensagem de erro
  errorStack        String?       @db.Text // Stack trace completo (opcional, mas útil para debug)
  errorType         String? // Tipo do erro (ex: "TimeoutError", "HTTPError", etc)
  // Contexto adicional
  submittedUrl      String? // URL original do post (backup)
  lastMetricsUpdate DateTime? // Última vez que foi atualizado com sucesso
  // Status e resolução
  status            FailureStatus @default(OPEN) // OPEN, RESOLVED, IGNORED
  resolvedAt        DateTime?
  resolvedBy        String? // ID do usuário que resolveu (opcional)
  resolutionNotes   String?       @db.Text
  // Metadados
  metadata          Json? // Dados adicionais (response HTTP, status code, etc)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  // Relações
  clipPost          ClipPost      @relation(fields: [clipPostId], references: [id], onDelete: Cascade)
  campaign          Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([clipPostId])
  @@index([campaignId])
  @@index([platform])
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt]) // Para queries de falhas abertas ordenadas por data
}

// ============================================================================
// RANKINGS - Cada registro contém o ranking COMPLETO do período
// ============================================================================

// Ranking Mensal - Snapshot do período mensal
model MonthlyRanking {
  id            String @id @default(cuid())
  campaignId    String
  rankingRuleId String

  // Período mensal
  monthPeriod String // Formato: "2025-01", "2025-02", etc.
  windowStart DateTime // Início do mês
  windowEnd   DateTime // Fim do mês

  // Estatísticas gerais do ranking
  totalParticipants Int    @default(0) // Total de pessoas no ranking
  totalPosts        Int    @default(0) // Total de posts considerados
  totalViews        BigInt @default(0) // Soma total de views de todos
  averageViews      Float? // Média de views por clipador

  // Metadados
  metadata     Json? // Dados adicionais, configurações usadas, etc.
  calculatedAt DateTime @default(now()) // Última atualização
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relações
  campaign    Campaign              @relation("MonthlyRankings", fields: [campaignId], references: [id], onDelete: Cascade)
  rankingRule RankingRule           @relation("MonthlyRankings", fields: [rankingRuleId], references: [id])
  entries     MonthlyRankingEntry[] // Sub-tabela com uma linha por clipador

  @@unique([campaignId, rankingRuleId, monthPeriod])
  @@index([campaignId, monthPeriod])
  @@index([calculatedAt])
}

// SUB-TABELA: Uma entrada por clipador no ranking mensal
// Atualizável incrementalmente a cada extração de métricas
model MonthlyRankingEntry {
  id               String @id @default(cuid())
  monthlyRankingId String
  clipperProfileId String
  applicationId    String

  // Posição e ranking
  position         Int // Posição atual no ranking (ordenado por totalViews DESC)
  previousPosition Int? // Posição anterior (para mostrar ↑↓)

  // Métricas acumuladas do mês
  totalViews    BigInt @default(0) // Total de views do mês
  totalLikes    Int    @default(0)
  totalComments Int    @default(0)
  totalShares   Int    @default(0)
  totalSaves    Int    @default(0)

  // Score calculado baseado no tipo de métrica da competição
  // Para VIEWS: rankingScore = totalViews
  // Para VIEWS_X_ENGAGEMENT: rankingScore = totalViews * engagementRate
  rankingScore Float @default(0) // Score usado para ordenar o ranking

  // Estatísticas derivadas
  postsCount          Int     @default(0) // Quantos posts o clipador tem
  averageViewsPerPost Float? // Média de views por post
  bestPostViews       BigInt? // Views do melhor post
  bestPostId          String? // ID do melhor post
  engagementRate      Float? // Taxa de engajamento geral

  // ============================================================================
  // CAMPOS PARA DESEMPATE MENSAL
  // ============================================================================

  // Contagem de vídeos por threshold de views (para desempate)
  videosOver100k Int @default(0) // Quantidade de vídeos com +100k views
  videosOver500k Int @default(0) // Quantidade de vídeos com +500k views

  // Data do primeiro post válido no mês (para desempate por quem postou primeiro)
  firstPostDate DateTime?

  // Prêmio calculado (baseado na posição e tabela de prêmios)
  prizeAmount Float  @default(0) // Valor do prêmio mensal (R$)
  prizeStatus String @default("PENDING") // "PENDING", "APPROVED", "PAID"

  // Cache de dados do clipador (desnormalizado para performance)
  clipperName     String?
  clipperUsername String?
  clipperImageUrl String?

  // Timestamps
  lastUpdated DateTime @default(now()) // Última vez que métricas foram atualizadas
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relações
  monthlyRanking MonthlyRanking     @relation(fields: [monthlyRankingId], references: [id], onDelete: Cascade)
  clipperProfile ClipperProfile     @relation(fields: [clipperProfileId], references: [id], onDelete: Cascade)
  application    ClipperApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([monthlyRankingId, clipperProfileId]) // Um clipador por ranking
  @@index([monthlyRankingId, position]) // Query rápida por posição
  @@index([monthlyRankingId, totalViews]) // Ordenação por views
  @@index([monthlyRankingId, rankingScore]) // Ordenação por score (VIEWS_X_ENGAGEMENT)
  @@index([clipperProfileId])
  @@index([applicationId]) // Busca de rankings por application (batch queries)
  @@index([lastUpdated])
  @@index([prizeStatus])
}

// Ranking Diário - Snapshot do dia específico
model DailyRanking {
  id            String @id @default(cuid())
  campaignId    String
  rankingRuleId String

  // Data específica do ranking
  rankingDate DateTime // Data do ranking (YYYY-MM-DD)

  // Estatísticas gerais do ranking do dia
  totalPosts      Int     @default(0) // Total de posts no ranking
  totalDailyViews BigInt  @default(0) // Soma de views ganhas no dia
  totalClippers   Int     @default(0) // Quantos clippers diferentes
  bestDailyViews  BigInt? // Maior número de views do dia
  averageViews    Float? // Média de views por post

  // Divulgação
  announced Boolean @default(false)

  /// Lote de pagamento PIX (Asaas) deste snapshot concluído com sucesso.
  dailyPixPayoutCompleted Boolean @default(false)

  // Metadados
  metadata     Json? // Dados adicionais
  calculatedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relações
  campaign    Campaign            @relation("DailyRankings", fields: [campaignId], references: [id], onDelete: Cascade)
  rankingRule RankingRule         @relation("DailyRankings", fields: [rankingRuleId], references: [id])
  entries     DailyRankingEntry[] // Sub-tabela com uma linha por post

  @@unique([campaignId, rankingRuleId, rankingDate])
  @@index([campaignId, rankingDate])
  @@index([rankingDate])
  @@index([calculatedAt])
}

// SUB-TABELA: Uma entrada por post no ranking diário
// Atualizável incrementalmente a cada extração de métricas
model DailyRankingEntry {
  id             String @id @default(cuid())
  dailyRankingId String
  clipPostId     String
  applicationId  String

  // Posição e ranking (ordenado por dailyViews DESC - 100% views)
  position         Int // Posição atual no ranking do dia
  previousPosition Int? // Posição no dia anterior (para mostrar ↑↓)

  // Métricas do DIA (delta desde ontem ou desde postagem até 23:59 do dia)
  dailyViews    BigInt @default(0) // Views ganhas HOJE
  dailyLikes    Int    @default(0) // Likes ganhos hoje
  dailyComments Int    @default(0) // Comentários ganhos hoje
  dailyShares   Int    @default(0) // Compartilhamentos ganhos hoje
  dailySaves    Int    @default(0) // Salvamentos ganhos hoje

  // Score calculado baseado no tipo de métrica da competição
  // Para VIEWS: dailyRankingScore = dailyViews
  // Para VIEWS_X_ENGAGEMENT: dailyRankingScore = dailyViews * engagementRate
  dailyRankingScore Float @default(0) // Score usado para ordenar o ranking diário

  // Métricas TOTAIS do post (acumuladas desde a postagem)
  totalViewsAtDate    BigInt @default(0) // Total de views até o fim do dia
  totalLikesAtDate    Int    @default(0) // Total de likes até o fim do dia
  totalCommentsAtDate Int    @default(0) // Total de comentários até o fim do dia
  totalSharesAtDate   Int    @default(0) // Total de shares até o fim do dia

  // ============================================================================
  // CAMPOS PARA DESEMPATE DIÁRIO
  // ============================================================================

  // Views nas primeiras 6 horas após postagem (para desempate)
  viewsFirst6h BigInt? @default(0)

  // Views nas primeiras 12 horas após postagem (para desempate)
  viewsFirst12h BigInt? @default(0)

  // Taxas e crescimento
  viewsGrowthRate Float? // % de crescimento vs dia anterior
  engagementRate  Float? // Taxa de engajamento do dia

  // ============================================================================
  // PRÊMIOS E BÔNUS
  // ============================================================================

  // Prêmio diário (baseado na posição e tabela de prêmios)
  dailyPrizeAmount Float  @default(0) // Valor do prêmio diário (R$)
  dailyPrizeStatus String @default("PENDING") // "PENDING", "APPROVED", "PAID"

  // Bônus por marco de views (1M+)
  qualifiesForBonus Boolean   @default(false) // Se o vídeo atingiu 1M+ views
  bonusAmount       Float     @default(0) // Valor do bônus (R$)
  bonusStatus       String    @default("PENDING") // "PENDING", "APPROVED", "PAID"
  bonusAwardedAt    DateTime? // Quando o bônus foi concedido

  // Cache de dados do post (desnormalizado para performance)
  postUrl       String?
  postThumbnail String?
  postCaption   String?   @db.Text
  platform      Platform?
  postedAt      DateTime?

  // Cache de dados do clipador
  clipperProfileId String?
  clipperName      String?
  clipperUsername  String?
  clipperImageUrl  String?

  // Desclassificação (soft-delete)
  isDisqualified Boolean @default(false)

  // Pagamento PIX direto (fluxo Asaas)
  dailyPrizePaid          Boolean   @default(false)
  dailyPrizePaidAt        DateTime?
  asaasTransferId         String?
  asaasPayoutReceiptUrl   String?
  dailyPixStatus          String    @default("PENDING")
  asaasExternalReference  String?
  asaasStatus             String?
  asaasFailReason         String?
  asaasEndToEndIdentifier String?
  asaasEffectiveDate      DateTime?
  asaasLastEvent          String?
  asaasLastEventId        String?
  asaasLastWebhookAt      DateTime?

  // Timestamps
  lastUpdated DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relações
  dailyRanking DailyRanking       @relation(fields: [dailyRankingId], references: [id], onDelete: Cascade)
  clipPost     ClipPost           @relation(fields: [clipPostId], references: [id], onDelete: Cascade)
  application  ClipperApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([dailyRankingId, clipPostId]) // Um post por ranking do dia
  @@index([dailyRankingId, position]) // Query rápida por posição
  @@index([dailyRankingId, dailyViews]) // Ordenação por views do dia
  @@index([dailyRankingId, dailyRankingScore]) // Ordenação por score (VIEWS_X_ENGAGEMENT)
  @@index([clipPostId])
  @@index([lastUpdated])
  @@index([dailyPrizeStatus])
  @@index([dailyPixStatus])
  @@index([asaasTransferId])
  @@index([asaasExternalReference])
  @@index([bonusStatus])
  @@index([qualifiesForBonus])
}

// ============================================================================
// ANTIFRAUDE E FLAGS
// ============================================================================

enum FraudFlagType {
  DUPLICATE // Link duplicado
  ANOMALOUS_ER // ER anômalo
  SUSPICIOUS_VELOCITY // Saltos suspeitos de views
  MISSING_HASHTAG // Sem hashtag obrigatória
  MISSING_MENTION // Sem menção obrigatória
  OUT_OF_DATE_RANGE // Fora do período
  PRIVATE_PROFILE // Perfil privado
  CONTENT_VIOLATION // Violação de conteúdo
  BOT_ACTIVITY // Atividade de bot detectada
  OTHER
}

enum FraudFlagSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FraudFlagStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_VALID // Flag válida, ação tomada
  RESOLVED_FALSE // Falso positivo
  IGNORED
}

model FraudFlag {
  id         String            @id @default(cuid())
  campaignId String
  clipPostId String?
  type       FraudFlagType
  severity   FraudFlagSeverity
  status     FraudFlagStatus   @default(OPEN)

  // Detalhes
  message      String
  details      Json? // Dados técnicos da detecção
  evidenceUrls String[] // Screenshots, links, etc.

  // Revisão
  reviewedBy  String?
  reviewedAt  DateTime?
  reviewNotes String?
  resolution  String? // Ação tomada

  // Metadados
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  campaign Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  clipPost ClipPost? @relation(fields: [clipPostId], references: [id], onDelete: SetNull)
  reviewer User?     @relation("FraudReviewer", fields: [reviewedBy], references: [id])

  @@index([campaignId])
  @@index([clipPostId])
  @@index([status])
  @@index([severity])
  @@index([type])
  @@index([createdAt])
}

// ============================================================================
// AUDITORIA
// ============================================================================

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  ENABLE
  DISABLE
  EXPORT
  LOGIN
  LOGOUT
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String?
  action     AuditAction
  entityType String // "Campaign", "Submission", "RankingRule", etc.
  entityId   String?
  campaignId String? // Para filtros rápidos

  // Dados da ação
  changes   Json? // Before/after
  metadata  Json? // Contexto adicional
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  // Relações
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([campaignId])
  @@index([action])
  @@index([createdAt])
}

// ============================================================================
// WEBHOOKS
// ============================================================================

model WebhookEndpoint {
  id             String   @id @default(cuid())
  organizationId String
  url            String
  secret         String // Para HMAC
  events         String[] // Eventos que escuta
  isActive       Boolean  @default(true)
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relações
  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   WebhookDelivery[]

  @@index([organizationId])
  @@index([isActive])
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
  RETRYING
}

model WebhookDelivery {
  id          String                @id @default(cuid())
  endpointId  String
  event       String
  payload     Json
  status      WebhookDeliveryStatus @default(PENDING)
  attempts    Int                   @default(0)
  maxAttempts Int                   @default(3)

  // Resposta
  responseStatus Int?
  responseBody   String?
  errorMessage   String?

  // Timing
  nextRetryAt DateTime?
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relações
  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId])
  @@index([status])
  @@index([createdAt])
  @@index([nextRetryAt])
}

model AsaasWebhookEvent {
  id          String    @id @default(cuid())
  eventId     String    @unique
  eventType   String?
  transferId  String?
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([transferId])
  @@index([eventType])
  @@index([processedAt])
  @@index([createdAt])
}

// ============================================================================
// NOTIFICAÇÕES
// ============================================================================

enum NotificationType {
  APPLICATION_APPROVED
  APPLICATION_REJECTED
  CLIP_POST_INELIGIBLE
  CLIP_POST_DISQUALIFIED
  RANKING_CHANGED
  CAMPAIGN_STARTED
  CAMPAIGN_ENDING
  CAMPAIGN_ENDED
  FRAUD_FLAG_OPENED
  FRAUD_FLAG_RESOLVED
  METRICS_MILESTONE
  SYSTEM_ALERT
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

model Notification {
  id      String              @id @default(cuid())
  userId  String
  type    NotificationType
  channel NotificationChannel @default(IN_APP)

  // Conteúdo
  title     String
  message   String
  actionUrl String?
  metadata  Json?

  // Status
  isRead Boolean   @default(false)
  readAt DateTime?
  sentAt DateTime?

  // Referências
  campaignId String?
  clipPostId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

// ============================================================================
// QUOTAS E USAGE
// ============================================================================

model QuotaUsage {
  id             String   @id @default(cuid())
  organizationId String
  resourceType   String // "INGEST", "ACTIVE_CAMPAIGNS", "CREATORS"
  period         String // "2025-01", formato YYYY-MM
  used           Int      @default(0)
  limit          Int
  lastResetAt    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relações
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, resourceType, period])
  @@index([organizationId])
  @@index([period])
}

// ============================================================================
// JOBS E PROCESSAMENTO
// ============================================================================

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model Job {
  id         String    @id @default(cuid())
  type       String // "INGEST_METRICS", "CALCULATE_RANKING", "FRAUD_DETECTION"
  campaignId String?
  status     JobStatus @default(PENDING)
  priority   Int       @default(0)

  // Dados do job
  input  Json?
  output Json?
  error  String?

  // Timing
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, priority])
  @@index([type])
  @@index([campaignId])
  @@index([createdAt])
}

// ============================================================================
// LISTA DE INTERESSE (PRÉ-QUALIFICAÇÃO)
// ============================================================================

enum InterestListForWhom {
  MYSELF // Para mim (sou o rosto da competição)
  REPRESENTING_PERSON // Estou representando uma pessoa (criador/influenciador)
  REPRESENTING_BRAND // Estou representando uma marca/empresa
}

enum InterestListUrgency {
  IMMEDIATE // Preciso para já (≤ 15 dias)
  SOON // Em breve (15–30 dias)
  PLANNING // Planejamento (30–60 dias)
  EXPLORATORY // Exploratório (> 60 dias)
}

enum InterestListBudget {
  RANGE_50_80 // R$ 50 mil – 80 mil
  RANGE_80_200 // R$ 80 mil – 200 mil
  RANGE_200_500 // R$ 200 mil – 500 mil
  ABOVE_500 // Acima de R$ 500 mil
  NOT_DEFINED // Ainda não definido (preciso de orientação)
}

enum InterestListStatus {
  PENDING // Aguardando análise
  CONTACTED // Já foi contatado
  QUALIFIED // Qualificado
  DISQUALIFIED // Desqualificado
  CONVERTED // Convertido em cliente
}

model InterestList {
  id String @id @default(cuid())

  // 1. Informações de contato
  fullName String // Nome completo
  email    String // E-mail de trabalho
  whatsapp String // WhatsApp com DDI e DDD

  // 4. Para quem é a competição
  forWhom InterestListForWhom

  // 5-7. Redes sociais
  instagramHandle String // Instagram (obrigatório)
  tiktokHandle    String? // TikTok (opcional)
  youtubeUrl      String? // YouTube (opcional)

  // 8. Links de performance (até 3)
  performanceLinks String[] // Array de URLs

  // 9. Objetivos
  objectives String // Texto 50-400 chars

  // 10. Urgência
  urgency InterestListUrgency

  // 11. Orçamento
  budget InterestListBudget

  // 12. Experiência prévia
  hasExperience      Boolean
  experienceFeedback String? // O que funcionou/não funcionou

  // 13. Métricas de sucesso (até 3)
  successMetrics String[] // Array de strings

  // 14. Comentários adicionais
  additionalComments String? // Opcional, até 800 chars

  // 15. Consentimentos (todos obrigatórios)
  agreeAuthority       Boolean // Confirmo poderes para contratar
  agreePublicAnalysis  Boolean // Autorizo análise pública
  agreePrivacyAndTerms Boolean // Li e concordo com Política/Termos

  // Status e metadados
  status     InterestListStatus @default(PENDING)
  metadata   Json? // Dados adicionais
  notes      String? // Notas internas da equipe comercial
  assignedTo String? // ID do membro da equipe que está analisando

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@index([urgency])
  @@index([budget])
}

// ============================================================================
// CARTEIRA E TRANSAÇÕES FINANCEIRAS
// ============================================================================

model Wallet {
  id               String @id @default(cuid())
  clipperProfileId String @unique

  // Saldos
  balance         Float @default(0) // Saldo disponível atual
  totalEarned     Float @default(0) // Total ganho histórico
  totalWithdrawn  Float @default(0) // Total sacado histórico
  pendingWithdraw Float @default(0) // Total em saques pendentes

  // Configurações
  currency    String    @default("BRL")
  isActive    Boolean   @default(true)
  blockedAt   DateTime? // Data de bloqueio (se aplicável)
  blockReason String? // Motivo do bloqueio

  // Metadados
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  clipperProfile ClipperProfile @relation(fields: [clipperProfileId], references: [id], onDelete: Cascade)
  transactions   Transaction[]

  @@index([clipperProfileId])
  @@index([isActive])
}

enum TransactionType {
  PRIZE_CREDIT // Crédito de prêmio
  BONUS // Bônus adicional
  ADJUSTMENT // Ajuste manual (positivo ou negativo)
  WITHDRAWAL_REQUEST // Solicitação de saque
  WITHDRAWAL_APPROVED // Saque aprovado
  WITHDRAWAL_REJECTED // Saque rejeitado (estorna valor)
  WITHDRAWAL_COMPLETED // Saque concluído
  WITHDRAWAL_CANCELLED // Saque cancelado pelo clipador
  REFUND // Estorno
  FEE // Taxa
}

enum TransactionStatus {
  PENDING // Pendente
  PROCESSING // Processando
  COMPLETED // Concluída
  REJECTED // Rejeitada
  CANCELLED // Cancelada
  FAILED // Falhou
}

enum WithdrawalMethod {
  PIX
  BANK_TRANSFER
  PAYPAL
  OTHER
}

model Transaction {
  id       String            @id @default(cuid())
  walletId String
  type     TransactionType
  status   TransactionStatus @default(PENDING)

  // Valores
  amount        Float // Valor da transação (positivo para crédito, negativo para débito)
  balanceBefore Float // Saldo antes da transação
  balanceAfter  Float // Saldo depois da transação
  currency      String @default("BRL")

  // Descrição e referências
  description     String
  campaignId      String? // Campanha relacionada (se aplicável)
  clipPostId      String? // Post relacionado (se aplicável)
  rankingPosition Int? // Posição no ranking (se prêmio)

  // Dados de saque (quando aplicável)
  withdrawalMethod  WithdrawalMethod?
  withdrawalDetails Json? // Dados da conta: PIX key, banco, agência, conta, etc.

  // Processamento
  processedBy     String? // ID do usuário que processou
  processedAt     DateTime?
  rejectionReason String? // Motivo de rejeição
  failureReason   String? // Motivo de falha

  // Comprovantes e evidências
  proofUrls String[] // URLs de comprovantes (ex: comprovante de transferência)

  // Metadados
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([type])
  @@index([status])
  @@index([campaignId])
  @@index([createdAt])
  @@index([processedAt])
}

// ============================================================================
// LINKS DE RASTREAMENTO
// ============================================================================

model Link {
  id               String   @id @default(cuid())
  campaignId       String
  clipperProfileId String?
  originalUrl      String   @db.Text
  shortId          String   @unique
  clicks           Int      @default(0)
  sales            Int      @default(0)
  successUrl       String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  campaign       Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  clipperProfile ClipperProfile? @relation(fields: [clipperProfileId], references: [id], onDelete: SetNull)

  @@index([shortId])
  @@index([campaignId])
  @@index([clipperProfileId])
}

// ============================================================================
// KIWIFY SALES
// ============================================================================

model KiwifySale {
  id                String           @id @default(cuid())
  kiwifyId          String           @unique
  reference         String?
  status            KiwifySaleStatus
  currency          String           @default("BRL")
  netAmount         Int              @default(0)
  productId         String?
  productName       String?
  customerEmail     String?
  affiliateDocument String?
  affiliateAmount   Int?
  clipperProfileId  String?
  clipperProfile    ClipperProfile?  @relation(fields: [clipperProfileId], references: [id], onDelete: SetNull)
  approvedDate      DateTime?
  kiwifyCreatedAt   DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([status])
  @@index([customerEmail])
  @@index([productId])
  @@index([kiwifyCreatedAt])
  @@index([createdAt])
  @@index([clipperProfileId])
  @@index([affiliateDocument])
}

enum KiwifySaleStatus {
  PAID
  REFUNDED
  CHARGEDBACK
  WAITING_PAYMENT
  EXPIRED
  REFUSED
}

// ============================================================================
// ACADEMIA - MÓDULOS E AULAS
// ============================================================================

model AcademyModule {
  id            String  @id @default(cuid())
  title         String // Título do módulo
  slug          String  @unique // Slug para URL amigável
  description   String? @db.Text // Descrição do módulo
  coverImageUrl String? // Imagem de capa do módulo

  // Ordenação e visibilidade
  order       Int     @default(0) // Ordem de exibição
  isPublished Boolean @default(false) // Se está publicado/visível

  // Metadados
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  lessons AcademyLesson[] // Aulas do módulo

  @@index([isPublished])
  @@index([order])
}

model AcademyLesson {
  id          String  @id @default(cuid())
  moduleId    String
  title       String // Título da aula
  slug        String  @unique // Slug para URL amigável
  description String? @db.Text // Descrição da aula

  // Conteúdo
  videoUrl     String // URL do vídeo (YouTube, Vimeo, etc.)
  thumbnailUrl String? // Thumbnail do vídeo
  duration     Int? // Duração em segundos

  // Ordenação e visibilidade
  order       Int     @default(0) // Ordem dentro do módulo
  isPublished Boolean @default(false) // Se está publicado/visível
  isFree      Boolean @default(false) // Se é aula gratuita (preview)

  // Metadados
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  module   AcademyModule           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress AcademyLessonProgress[] // Progresso dos usuários
  likes    AcademyLessonLike[] // Curtidas

  @@index([moduleId])
  @@index([isPublished])
  @@index([order])
  @@index([isFree])
}

// Progresso do usuário nas aulas (marcar como visto)
model AcademyLessonProgress {
  id       String @id @default(cuid())
  lessonId String
  userId   String

  // Progresso
  completed       Boolean   @default(false) // Se completou a aula
  watchedAt       DateTime? // Quando marcou como visto
  progressPercent Int       @default(0) // Percentual de progresso (0-100)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  lesson AcademyLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([lessonId, userId]) // Um progresso por usuário por aula
  @@index([lessonId])
  @@index([userId])
  @@index([completed])
}

// Curtidas nas aulas
model AcademyLessonLike {
  id       String @id @default(cuid())
  lessonId String
  userId   String

  createdAt DateTime @default(now())

  // Relações
  lesson AcademyLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([lessonId, userId]) // Uma curtida por usuário por aula
  @@index([lessonId])
  @@index([userId])
}

model TikTokConnection {
  id               String           @id @default(cuid())
  clipperProfileId String
  socialAccountId  String?          @unique
  openId           String           @unique
  accessToken      String
  refreshToken     String
  expiresAt        DateTime
  refreshExpiresAt DateTime?
  tokenType        String           @default("Bearer")
  scope            String?
  username         String?
  displayName      String?
  avatarUrl        String?
  status           TikTokAuthStatus @default(ACTIVE)
  lastSyncAt       DateTime?
  errorMessage     String?
  metadata         Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  clipperProfile   ClipperProfile   @relation(fields: [clipperProfileId], references: [id], onDelete: Cascade)
  socialAccount    SocialAccount?   @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  syncLogs         TikTokSyncLog[]

  @@unique([clipperProfileId, openId])
  @@index([clipperProfileId])
  @@index([socialAccountId])
  @@index([openId])
  @@index([status])
  @@index([expiresAt])
}

enum TikTokAuthStatus {
  PENDING
  ACTIVE
  EXPIRED
  REVOKED
  ERROR
}

enum TikTokSyncStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  PARTIAL
}

model TikTokSyncLog {
  id                 String           @id @default(cuid())
  tiktokConnectionId String
  status             TikTokSyncStatus @default(PENDING)
  videosProcessed    Int              @default(0)
  videosUpdated      Int              @default(0)
  videosFailed       Int              @default(0)
  startedAt          DateTime?
  completedAt        DateTime?
  duration           Int?
  errorMessage       String?
  errorDetails       Json?
  logs               Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  tiktokConnection TikTokConnection @relation(fields: [tiktokConnectionId], references: [id], onDelete: Cascade)

  @@index([tiktokConnectionId])
  @@index([status])
  @@index([createdAt])
}

model ClipPostBucketVideo {
  id                    String                                 @id @default(cuid())
  clipPostId            String                                 @unique
  campaignId            String
  submittedUrl          String
  status                ClipPostBucketVideoStatus              @default(QUEUED)
  gcsUri                String?
  publicUrl             String?
  bucketName            String?
  destinationPath       String?
  fileName              String?
  transcriptionStatus   ClipPostBucketVideoTranscriptionStatus @default(PENDING)
  transcription         String?                                @db.Text
  transcriptionLanguage String?
  transcriptionModel    String?
  transcriptionError    String?                                @db.Text
  transcribedAt         DateTime?
  attempts              Int                                    @default(0)
  errorMessage          String?
  startedAt             DateTime?
  completedAt           DateTime?
  createdAt             DateTime                               @default(now())
  updatedAt             DateTime                               @updatedAt
  clipPost              ClipPost                               @relation(fields: [clipPostId], references: [id], onDelete: Cascade)
  campaign              Campaign                               @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([clipPostId])
  @@index([status])
  @@index([transcriptionStatus])
}

// ============================================================================
// BLOG - CATEGORIAS, POSTS, COMENTÁRIOS, LIKES E VIEWS
// ============================================================================

enum BlogPostStatus {
  DRAFT // Rascunho
  SCHEDULED // Agendado para publicação futura
  PUBLISHED // Publicado e visível
  ARCHIVED // Arquivado (não aparece mais no blog)
}

enum BlogCommentStatus {
  PENDING // Aguardando moderação
  APPROVED // Aprovado e visível
  REJECTED // Rejeitado pelo admin
  SPAM // Marcado como spam
}

// Categorias do blog (ex: "Dicas de Clipping", "Tutoriais", "Novidades")
model BlogCategory {
  id            String  @id @default(cuid())
  title         String // Nome da categoria
  slug          String  @unique // URL amigável (ex: dicas-de-clipping)
  description   String? @db.Text // Descrição da categoria
  coverImageUrl String? // Imagem de capa
  color         String? // Cor hex para UI (badges, ícones, gradientes)

  // Ordenação e visibilidade
  order    Int     @default(0) // Ordem de exibição
  isActive Boolean @default(true) // Se está visível no blog

  // Metadados
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  posts BlogPost[] // Posts desta categoria

  @@index([isActive])
  @@index([order])
  @@index([slug])
}

// Post do blog (conteúdo em Markdown, com imagem de capa e SEO)
model BlogPost {
  id         String  @id @default(cuid())
  authorId   String // Relação com User (quem escreveu)
  categoryId String? // Relação com BlogCategory (opcional)

  // Conteúdo
  title         String // Título do post
  slug          String   @unique // URL amigável
  excerpt       String?  @db.Text // Resumo/preview curto para cards e listagens
  content       String   @db.Text // Conteúdo completo em Markdown
  coverImageUrl String? // Imagem de capa principal do post
  tags          String[] // Tags (ex: ["clipfy", "tutorial", "tiktok"])

  // Status e publicação
  status      BlogPostStatus @default(DRAFT) // Status do post
  publishedAt DateTime? // Data/hora efetiva da publicação
  scheduledAt DateTime? // Data/hora agendada (quando status = SCHEDULED)

  // Destaques
  isFeatured Boolean @default(false) // Post em destaque (banner, home)
  isPinned   Boolean @default(false) // Fixado no topo da listagem

  // SEO
  metaTitle       String? // Título personalizado para <title> (Google)
  metaDescription String? // Meta description para SEO
  metaKeywords    String[] // Keywords de SEO

  // Métricas desnormalizadas (contadores rápidos, atualizados via trigger/incremento)
  viewsCount      Int  @default(0) // Total de visualizações (logados + anônimos)
  likesCount      Int  @default(0) // Total de curtidas (apenas logados)
  commentsCount   Int  @default(0) // Total de comentários aprovados
  sharesCount     Int  @default(0) // Total de compartilhamentos
  readTimeMinutes Int? // Tempo estimado de leitura (calculado pelo tamanho do content)

  // Metadados
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  author   User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category BlogCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  comments BlogComment[] // Comentários do post
  likes    BlogPostLike[] // Curtidas do post
  views    BlogPostView[] // Visualizações detalhadas (para métricas)

  @@index([authorId])
  @@index([categoryId])
  @@index([slug])
  @@index([status])
  @@index([publishedAt])
  @@index([isFeatured])
  @@index([isPinned])
  @@index([createdAt])
  @@index([status, publishedAt]) // Posts publicados ordenados por data
}

// Comentários dos posts (suporte a respostas aninhadas via parentId)
// Apenas usuários LOGADOS podem comentar
model BlogComment {
  id       String  @id @default(cuid())
  postId   String // Relação com BlogPost
  authorId String // Relação com User (obrigatório - precisa estar logado)
  parentId String? // ID do comentário pai (para respostas/threads)

  // Conteúdo
  content String @db.Text // Texto do comentário

  // Moderação
  status BlogCommentStatus @default(PENDING) // Status de moderação

  // Destaques
  isPinned   Boolean   @default(false) // Comentário fixado pelo admin
  likesCount Int       @default(0) // Likes desnormalizados (para ordenação rápida)
  editedAt   DateTime? // Data da última edição (null = nunca editado)

  // Metadados
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  post    BlogPost          @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  BlogComment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies BlogComment[]     @relation("CommentReplies") // Respostas a este comentário
  likes   BlogCommentLike[] // Curtidas no comentário

  @@index([postId])
  @@index([authorId])
  @@index([parentId])
  @@index([status])
  @@index([createdAt])
  @@index([postId, status]) // Comentários aprovados de um post
}

// Curtida no post (apenas usuários LOGADOS)
model BlogPostLike {
  id     String @id @default(cuid())
  postId String // Relação com BlogPost
  userId String // Relação com User (obrigatório - precisa estar logado)

  createdAt DateTime @default(now())

  // Relações
  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId]) // Uma curtida por usuário por post
  @@index([postId])
  @@index([userId])
}

// Curtida no comentário (apenas usuários LOGADOS)
model BlogCommentLike {
  id        String @id @default(cuid())
  commentId String // Relação com BlogComment
  userId    String // Relação com User (obrigatório - precisa estar logado)

  createdAt DateTime @default(now())

  // Relações
  comment BlogComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId]) // Uma curtida por usuário por comentário
  @@index([commentId])
  @@index([userId])
}

// Visualização de post (logados E anônimos — para métricas detalhadas)
// userId é OPCIONAL: null = visitante anônimo, preenchido = usuário logado
model BlogPostView {
  id     String @id @default(cuid())
  postId String // Relação com BlogPost

  // Identificação do visitante
  userId    String? // Usuário logado (null = anônimo)
  sessionId String? // ID de sessão para agrupar views do mesmo visitante anônimo
  ipHash    String? // Hash do IP (privacidade - não salva IP raw)

  // Origem e contexto
  referrer  String? // De onde veio (ex: "google", "instagram", "direct", URL completa)
  utmSource String? // UTM source (ex: "newsletter", "instagram")
  utmMedium String? // UTM medium (ex: "email", "social")

  // Dispositivo e localização
  userAgent String? // User-Agent do navegador
  device    String? // "mobile", "desktop", "tablet"
  browser   String? // "Chrome", "Safari", "Firefox"
  os        String? // "iOS", "Android", "Windows", "macOS"
  country   String? // País do visitante (ex: "BR", "US")
  region    String? // Estado/região (ex: "SP", "RJ")

  // Engajamento
  readPercent   Int? // Percentual de leitura do post (0-100, via scroll tracking)
  timeOnPageSec Int? // Tempo na página em segundos

  viewedAt DateTime @default(now()) // Quando visualizou

  // Relações
  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
  @@index([viewedAt])
  @@index([postId, viewedAt]) // Views de um post por período
  @@index([device])
  @@index([country])
  @@index([referrer])
}

