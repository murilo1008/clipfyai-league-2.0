  youtubeAuth         YouTubeAuth?
  instagramAuth       InstagramAuth?
  tiktokAuth          TikTokConnection?
  clipPosts           ClipPost[]

  @@unique([clipperProfileId, platform, username]) // Uma conta única por clipper/plataforma/username
  @@index([clipperProfileId])
  @@index([platform])
  @@index([username])
  @@index([isPrimary])
}

