  @@index([clipPostId, sentiment])
  @@index([campaignId, sentiment])
  @@index([textHash])
  @@index([textHash, promptVersion, model, analyzedAt])
  @@index([clipPostId, promptVersion, model, commentId, analyzedAt])
  @@index([campaignId, promptVersion, model, commentId, analyzedAt])
  @@index([analyzedAt])
}

model CommentAnalysisAggregate {
  id                   String                        @id @default(cuid())
