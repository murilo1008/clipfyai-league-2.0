// ClipfyAI - Schema Prisma
// Plataforma de gerenciamento de competições de cortes cross-plataforma

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// AUTENTICAÇÃO E USUÁRIOS
// ============================================================================

enum UserRole {
  ADMIN // Admin Clipfy - controle total do sistema
  ORGANIZER_ADMIN // Admin Organizador - gerencia campanhas
  CLIENT // Cliente - empresa/influenciador que vê resultados
  CLIPPER // Clipador - participante das competições
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  TRIAL
  NONE
}

enum SubscriptionTier {
  NONE // Sem assinatura
  PRO // Clipfy League PRO
  ULTRA // Clipfy League ULTRA (upgrade do PRO)
}

model User {
  id                  String   @id // ID do Clerk (não gera CUID)
  email               String   @unique
  name                String?
  imageUrl            String?
  onboardingCompleted Boolean  @default(false)
  role                UserRole @default(CLIPPER)
  referralSlug        String? // Slug de origem do cadastro (ex: slug da competição, canal, campanha)
  referredByClipperId String? // Clipador afiliado responsável por este cadastro
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Possui loja
  hasStore Boolean @default(false)

  // Loja Kiwify
  hasKiwifyStore  Boolean @default(false)
  kiwifyClientId  String?
  kiwifySecretKey String?
  kiwifyAccountId String?

  subscriptionStatus SubscriptionStatus @default(NONE)
  subscriptionTier   SubscriptionTier   @default(NONE) // Tier da assinatura (PRO, ULTRA)

  // Dados específicos do ULTRA
  ultraSubscriptionId   String? // ID da assinatura ULTRA na Kiwify
  ultraOrderId          String? // ID do pedido ULTRA na Kiwify
  ultraSubscriptionDate DateTime? // Data de assinatura do ULTRA

  // Produtos de compra única
  hasClipperManual          Boolean   @default(false) // Manual do Clipador (produto único Kiwify)
  clipperManualPurchaseDate DateTime? // Data da compra do Manual

  // Kiwify (nova plataforma de pagamento)
  kiwifySubscriptionId String? // ID da assinatura na Kiwify
  kiwifyOrderId        String? // ID do pedido na Kiwify

  // Plataforma de pagamento atual (para saber onde cancelar)
  paymentPlatform String? // "kiwify"

  lastPurchaseDate DateTime? // Data da última compra

  // Relações
  organizations     OrganizationMember[]
  createdCampaigns  Campaign[]           @relation("CampaignCreator")
  clientCampaigns   Campaign[]           @relation("CampaignClient") // Campanhas do cliente
  clipperProfile    ClipperProfile?
  clientProfile     ClientProfile?
  auditLogs         AuditLog[]
  notifications     Notification[]
  fraudReviews      FraudFlag[]          @relation("FraudReviewer")
  referredByClipper ClipperProfile?      @relation("ClipperReferrals", fields: [referredByClipperId], references: [id], onDelete: SetNull)

  // Academia
  lessonProgress AcademyLessonProgress[]
  lessonLikes    AcademyLessonLike[]

  // Blog
  blogPosts        BlogPost[]
  blogComments     BlogComment[]
  blogPostLikes    BlogPostLike[]
  blogCommentLikes BlogCommentLike[]

  @@index([email])
  @@index([role])
  @@index([referredByClipperId])
}

// ============================================================================
// ORGANIZAÇÕES E MEMBROS
// ============================================================================

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  logoUrl     String?
  website     String?
  country     String?
  timezone    String   @default("UTC")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Configurações de quotas
  quotaMonthlyIngest       Int @default(100000) // Limite de coletas mensais
  quotaActiveCampaigns     Int @default(5)
  quotaCreatorsPerCampaign Int @default(1000)

  // Relações
  members          OrganizationMember[]
  campaigns        Campaign[]
  webhookEndpoints WebhookEndpoint[]
  quotaUsage       QuotaUsage[]
  youtubeShopAuths YouTubeShopAuth[]

  @@index([slug])
  @@index([isActive])
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model OrganizationMember {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  role           OrganizationRole @default(MEMBER)
  permissions    Json? // Permissões granulares customizadas
  invitedBy      String?
  joinedAt       DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // Relações
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

// ============================================================================
// CAMPANHAS (COMPETIÇÕES)
// ============================================================================

enum CampaignStatus {
  DRAFT // Rascunho
  SCHEDULED // Agendada
  ACTIVE // Ativa
  PAUSED // Pausada
  COMPLETED // Concluída
  ARCHIVED // Arquivada
}

// Tipo de métrica usada para calcular o ranking da competição
enum RankingMetricType {
  VIEWS // Apenas Views (padrão atual)
  VIEWS_X_ENGAGEMENT // Views multiplicado pela taxa de engajamento
}

enum SpotifyMetricsRunStatus {
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

enum SpotifyMetricsRunItemStatus {
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
}

enum ClipPostBucketVideoStatus {
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
}

enum ClipPostBucketVideoTranscriptionStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

model Campaign {
  id             String         @id @default(cuid())
  organizationId String
  creatorId      String // User que criou (admin/organizer)
  clientId       String? // Cliente proprietário da campanha
  name           String
  slug           String         @unique
  description    String?
  status         CampaignStatus @default(DRAFT)

  // Período
  startDate   DateTime
  endDate     DateTime
  timezone    String    @default("UTC")
  publishedAt DateTime?

  // Configurações
  platforms         String[] // ["INSTAGRAM", "TIKTOK", "YOUTUBE", "KWAI", "FACEBOOK"]
  requiredHashtags  String[] // Hashtags obrigatórias
  requiredMentions  String[] // @menções obrigatórias
  prohibitedContent String[] // Palavras/temas proibidos
  eligibilityRules  Json? // Regras adicionais de elegibilidade

  // Landing page
  landingUrl          String? // URL customizada
  landingContent      String? // Conteúdo markdown
  isLeaderboardPublic Boolean @default(false)
  coverImageUrl       String? // URL da imagem de capa (1:1 - quadrada)

  // Privacidade
  isPrivate Boolean @default(false) // Se true, competição é privada (acesso restrito)
  isProOnly Boolean @default(false) // Se true, apenas assinantes PRO podem se inscrever

  // Download de vídeos
  downloadVideos Boolean @default(false) // Se true, todos os vídeos desta competição serão baixados

  // Métricas de plays de músicas vinculadas no Spotify
  spotifyMetricsEnabled Boolean @default(false)

  // Configurações de ranking
  activeRankingRuleId String?
  tiebreakerRules     Json? // Regras de desempate
  rankingMetricType   RankingMetricType @default(VIEWS) // Tipo de métrica usada para ranking

  // Configurações de triagem
  requiresApproval    Boolean @default(true)
  autoApproveCreators Boolean @default(false)

  // Pagamento PIX do rank diário (fluxo Asaas após crédito na carteira)
  dailyPix Boolean @default(false)

  // Ranking diário de clipadores por quantidade de vídeos publicados
  topClippersRankingEnabled Boolean @default(false)
  topClippersPrizeTable     Json?

  // ============================================================================
  // LINKS DE AFILIADOS (OPCIONAIS)
  // URLs base para links de afiliados - o ID do ClipperProfile será adicionado no frontend
  // ============================================================================
  affiliateLinkInstagram String? // Link de afiliado para Instagram
  affiliateLinkTiktok    String? // Link de afiliado para TikTok
  affiliateLinkYoutube   String? // Link de afiliado para YouTube
  affiliateLinkFacebook  String? // Link de afiliado para Facebook
  affiliateLinkKwai      String? // Link de afiliado para Kwai

  // Metadados
  termsUrl  String?
  prizeInfo Json? // Informações sobre prêmios
  metadata  Json? // Dados customizados
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  organization              Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator                   User                           @relation("CampaignCreator", fields: [creatorId], references: [id])
  client                    User?                          @relation("CampaignClient", fields: [clientId], references: [id], onDelete: SetNull)
  activeRankingRule         RankingRule?                   @relation("ActiveRankingRule", fields: [activeRankingRuleId], references: [id])
  rankingRules              RankingRule[]                  @relation("CampaignRankingRules")
  applications              ClipperApplication[]
  clipPosts                 ClipPost[]
  metricsExtractionRuns     CampaignMetricsExtractionRun[]
  monthlyRankings           MonthlyRanking[]               @relation("MonthlyRankings")
  dailyRankings             DailyRanking[]                 @relation("DailyRankings")
  fraudFlags                FraudFlag[]
  auditLogs                 AuditLog[]
  notifications             Notification[]
  metricsExtractionFailures MetricsExtractionFailure[]
  links                     Link[] // Links de rastreamento
  bucketVideos              ClipPostBucketVideo[] // Vídeos baixados no bucket
  rawVideos                 RawVideo[]                     @relation("CampaignRawVideos")
  spotifyTracks             CampaignSpotifyTrack[]
  commentAnalysisJobs       CommentAnalysisJob[]
  commentAnalysisAggregates CommentAnalysisAggregate[]

  @@index([organizationId])
  @@index([slug])
  @@index([status])
  @@index([startDate, endDate])
  @@index([creatorId])
  @@index([clientId])
}

// ============================================================================
// MÉTRICAS DE MÚSICAS DO SPOTIFY
// ============================================================================

model SpotifyTrack {
  id              String    @id @default(cuid())
  spotifyTrackId  String    @unique // ID público de 22 caracteres
  spotifyUri      String    @unique
  shareUrl        String?
  name            String?
  artists         Json?
  albumName       String?
  albumImageUrl   String?
  lastCollectedAt DateTime?
  lastError       String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  campaigns CampaignSpotifyTrack[]
  metrics   SpotifyTrackMetric[]
  runItems  SpotifyMetricsRunItem[]

  @@index([lastCollectedAt])
}

model CampaignSpotifyTrack {
  id             String   @id @default(cuid())
  campaignId     String
  spotifyTrackId String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  spotifyTrack SpotifyTrack @relation(fields: [spotifyTrackId], references: [id], onDelete: Cascade)

  @@unique([campaignId, spotifyTrackId])
  @@index([campaignId, isActive])
  @@index([spotifyTrackId, isActive])
}

model SpotifyTrackMetric {
  id             String   @id @default(cuid())
  spotifyTrackId String
  playCount      BigInt
  collectedAt    DateTime @default(now())
  createdAt      DateTime @default(now())

  spotifyTrack SpotifyTrack @relation(fields: [spotifyTrackId], references: [id], onDelete: Cascade)

  @@index([spotifyTrackId, collectedAt])
  @@index([collectedAt])
}

model SpotifyMetricsRun {
  id             String                  @id @default(cuid())
  status         SpotifyMetricsRunStatus @default(RUNNING)
  totalCount     Int                     @default(0)
  processedCount Int                     @default(0)
  successCount   Int                     @default(0)
  failedCount    Int                     @default(0)
  startedAt      DateTime                @default(now())
  completedAt    DateTime?
  errorMessage   String?                 @db.Text
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  items SpotifyMetricsRunItem[]

  @@index([status, createdAt])
}

model SpotifyMetricsRunItem {
  id             String                      @id @default(cuid())
  runId          String
  spotifyTrackId String
  status         SpotifyMetricsRunItemStatus @default(QUEUED)
  attemptsMade   Int                         @default(0)
  errorMessage   String?                     @db.Text
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  run          SpotifyMetricsRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  spotifyTrack SpotifyTrack      @relation(fields: [spotifyTrackId], references: [id], onDelete: Cascade)

  @@unique([runId, spotifyTrackId])
  @@index([runId, status])
  @@index([spotifyTrackId])
}

// ============================================================================
// REGRAS DE RANKING (VERSIONADAS) - 100% VIEWS
// ============================================================================

model RankingRule {
  id          String  @id @default(cuid())
  campaignId  String
  label       String // "V1", "V2", etc.
  description String?
  version     Int     @default(1)
  isActive    Boolean @default(false)

  // ============================================================================
  // PREMIAÇÃO DIÁRIA
  // ============================================================================

  // Configurações gerais do ranking diário
  dailyEnabled          Boolean @default(true) // Se ativa premiação diária
  dailyTopCount         Int     @default(15) // Quantidade de posições premiadas por dia
  dailyTotalPrize       Float   @default(1000) // Total de prêmios por dia (R$)
  dailyTotalMonthBudget Float   @default(30000) // Budget mensal total diário (R$)

  // Tabela de prêmios diária (JSON)
  // Formato: { "1": 350, "2": 200, "3": 150, "4-15": 25 }
  dailyPrizeTable Json

  // Janela de tempo para considerar views diárias
  dailyWindowStart String @default("00:00") // Hora inicial (formato HH:mm)
  dailyWindowEnd   String @default("23:59") // Hora final (formato HH:mm)
  dailyTimezone    String @default("America/Sao_Paulo") // Timezone BRT

  // Regras de desempate diário (ordem de prioridade)
  // Formato: ["views_6h", "views_12h", "posted_earlier"]
  dailyTiebreakerRules Json

  // ============================================================================
  // BÔNUS POR MARCO DE VIEWS
  // ============================================================================

  bonusEnabled          Boolean @default(false) // Se ativa bônus por milestone
  bonusMilestone        Int     @default(1000000) // Views necessárias para bônus (1M)
  bonusAmount           Float   @default(100) // Valor do bônus (R$)
  bonusDeductFromDaily  Boolean @default(false) // Se true, abate do pool diário; se false, é à parte
  bonusMonthlyBudgetCap Float?  @default(6000) // Teto mensal de bônus (R$) - null = sem limite

  // ============================================================================
  // PREMIAÇÃO MENSAL
  // ============================================================================

  monthlyEnabled    Boolean @default(true) // Se ativa premiação mensal
  monthlyTopCount   Int     @default(10) // Quantidade de posições premiadas no mês
  monthlyTotalPrize Float   @default(20000) // Total de prêmios mensais (R$)

  // Tabela de prêmios mensal (JSON)
  // Formato: { "1": 7000, "2": 4000, "3": 3000, ... "10": 400 }
  monthlyPrizeTable Json

  // Regras de desempate mensal (ordem de prioridade)
  // Formato: ["videos_100k", "videos_500k", "peak_views", "first_post"]
  monthlyTiebreakerRules Json

  // Limiares para contagem de vídeos no desempate
  monthlyThreshold100k Int @default(100000) // Threshold para contar vídeos com +100k
  monthlyThreshold500k Int @default(500000) // Threshold para contar vídeos com +500k

  // ============================================================================
  // CONFIGURAÇÕES GERAIS
  // ============================================================================

  // Métrica principal (mantido como String para compatibilidade)
  // Use rankingMetricType no Campaign para a nova funcionalidade
  primaryMetric String @default("VIEWS") // "VIEWS", "ENGAGEMENT", etc.

  // Plataformas elegíveis
  eligiblePlatforms String[] @default(["INSTAGRAM", "TIKTOK", "YOUTUBE", "FACEBOOK", "KWAI"])

  // Se o mesmo corte sair em várias plataformas, considerar apenas a melhor
  countBestPlatformOnly Boolean @default(true)

  // Observações e regras adicionais (texto livre)
  notes String?

  // Metadados para futuras automações
  automationConfig Json? // Configurações para jobs automáticos

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  campaign        Campaign         @relation("CampaignRankingRules", fields: [campaignId], references: [id], onDelete: Cascade)
  activeCampaigns Campaign[]       @relation("ActiveRankingRule")
  monthlyRankings MonthlyRanking[] @relation("MonthlyRankings")
  dailyRankings   DailyRanking[]   @relation("DailyRankings")

  @@unique([campaignId, version])
  @@index([campaignId, isActive])
  @@index([isActive])
}

// ============================================================================
// CLÃS
// ============================================================================

model Clan {
  id          String  @id @default(cuid())
  name        String // Nome do clã (ex: "Alpha Squad")
  tag         String  @unique @db.VarChar(4) // Tag de no máximo 4 letras (ex: "ALFA")
  emoji       String // Emoji do clã (ex: "🔥", "⚡", "🐉")
  emojiColor  String // Cor hex do emoji/badge (ex: "#FF5733")
  imageUrl    String? // Imagem do clã (proporção 1:1)
  description String? @db.Text // Descrição do clã

  // Dono do clã (clipador responsável por aprovar/rejeitar inscrições)
  ownerId String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  owner        ClipperProfile?   @relation("ClanOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  members      ClipperProfile[]  @relation("ClanMembers")
  applications ClanApplication[]

  @@index([tag])
  @@index([isActive])
  @@index([ownerId])
}

enum ClanApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model ClanApplication {
  id        String @id @default(cuid())
  clanId    String
  clipperId String

  status     ClanApplicationStatus @default(PENDING)
  message    String?               @db.Text // Mensagem opcional do clipador ao se inscrever
  reviewedAt DateTime?
  reviewedBy String? // userId de quem aprovou/rejeitou (owner ou admin)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  clan    Clan           @relation(fields: [clanId], references: [id], onDelete: Cascade)
  clipper ClipperProfile @relation(fields: [clipperId], references: [id], onDelete: Cascade)

  @@unique([clanId, clipperId])
  @@index([clanId, status])
  @@index([clipperId])
}

// ============================================================================
// PERFIL DO CLIPADOR (CLIPPER)
// ============================================================================

enum ClipperVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
  BANNED
}

model ClipperProfile {
  id            String  @id @default(cuid())
  userId        String  @unique
  affiliateCode String? @unique

  // Identificação
  fullName        String
  artisticName    String?
  phone           String  @default("")
  cpf             String  @default("")
  pixKey          String  @default("")
  country         String  @default("Brasil")
  state           String  @default("")
  city            String  @default("")
  discordUsername String  @default("") // Username do Discord (ex: @usuario)
  discordId       String  @default("") // ID do Discord (números)

  // Clã (opcional)
  clanId String?

  // Classes
  classesInterestedIn Boolean @default(false)

  // Perfis sociais - Arrays para múltiplas contas
  instagramUsernames String[] // ["@conta1", "@conta2", "@conta3"]
  tiktokUsernames    String[] // ["@conta1", "@conta2"]
  youtubeUsernames   String[] // ["@canal1", "@canal2"]
  kwaiUsernames      String[] // ["@conta1", "@conta2"]
  facebookUsernames  String[] // ["@conta1", "@conta2"]

  // Histórico e capacidade
  niches            String[] // ["Gaming", "Tech", "Lifestyle"]
  tools             String[] // ["Premiere", "CapCut", "DaVinci"]
  postingFrequency  String   @default("") // "3-5/semana"
  portfolioLinks    String[] // Links para melhores cortes
  avgViews          Int?
  avgEngagementRate Float?
  bestVideoUrl      String?
  bestVideoViews    Int?
  weeklyCommitment  String   @default("") // Quantos vídeos pode postar por dia

  // Conformidade e motivação
  agreeToTerms          Boolean @default(false)
  agreeToCompliance     Boolean @default(false)
  agreeToPublicProfile  Boolean @default(false)
  agreeToDataProcessing Boolean @default(false)
  isOver18              Boolean @default(false)
  motivationText        String  @default("") // Por que quer participar

  // Verificação e scoring
  verificationStatus ClipperVerificationStatus @default(UNVERIFIED)
  autoScore          Float? // Score automático de triagem
  verifiedAt         DateTime?

  // Metadados
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  clan                  Clan?                 @relation("ClanMembers", fields: [clanId], references: [id], onDelete: SetNull)
  ownedClans            Clan[]                @relation("ClanOwner")
  clanApplications      ClanApplication[]
  applications          ClipperApplication[]
  wallet                Wallet?
  socialAccounts        SocialAccount[] // Nova relação com contas de redes sociais
  monthlyRankingEntries MonthlyRankingEntry[] // Entradas em rankings mensais
  links                 Link[] // Links de rastreamento
  kiwifySales           KiwifySale[] // Vendas da Kiwify
  tiktokConnections     TikTokConnection[]
  referredUsers         User[]                @relation("ClipperReferrals")

  @@index([userId])
  @@index([clanId])
  @@index([verificationStatus])
}

// ============================================================================
// PERFIL DO CLIENTE (CLIENT)
// ============================================================================

model ClientProfile {
  id     String @id @default(cuid())
  userId String @unique

  // Informações Básicas
  fullName String?
  phone    String?
  cpf      String? // Ou CNPJ se for empresa

  // Informações da Empresa/Organização
  company  String?
  position String? // Cargo na empresa
  website  String?

  // Localização
  country String? @default("Brasil")
  state   String?
  city    String?

  // Notas e Observações
  notes String? @db.Text // Notas internas sobre o cliente

  // Status
  status ClientStatus @default(PENDING) // Status do cliente

  // Metadados
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

enum ClientStatus {
  ACTIVE // Cliente ativo
  INACTIVE // Cliente inativo
  PENDING // Aguardando ativação
}

