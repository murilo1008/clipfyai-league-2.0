enum Platform {
  INSTAGRAM
  TIKTOK
  YOUTUBE
  KWAI
  FACEBOOK
}

enum ClipPostStatus {
  PENDING // Aguardando validação
  ELIGIBLE // Elegível ("Tem as # e @ obrigatórias")
  INELIGIBLE // Inelegível ("Não tem as # e @ obrigatórias")
  DISQUALIFIED // Desclassificado (fraude - compra de views)
}

enum MetricsExtractionRunStatus {
  DISCOVERING
  RUNNING
  COMPLETED
  FAILED
}

enum MetricsExtractionRunItemStatus {
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
  SKIPPED
}

enum CommentAnalysisScope {
  POST
  CAMPAIGN
}

enum CommentAnalysisJobStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum CommentAnalysisItemStatus {
  PENDING
  PROCESSING
  COMPLETED
  SKIPPED
  FAILED
}

enum CommentAnalysisAggregateScope {
  POST
  CAMPAIGN
}

model ClipPost {
  id            String   @id @default(cuid())
  campaignId    String
  applicationId String
  platform      Platform

  // URL e identificação
  submittedUrl    String // URL original enviada pelo clipador
  normalizedUrl   String? // URL limpa/padronizada (sem parâmetros)
  platformVideoId String? // ID único do vídeo na plataforma (ex: ABC123xyz)

  // Dados extraídos do vídeo
  username     String? // Username da conta que postou
  caption      String? // Legenda completa
  hashtags     String[]  @default([]) // Hashtags extraídas da legenda
  mentions     String[]  @default([]) // Menções (@) extraídas da legenda
  thumbnailUrl String?
  duration     Int? // Duração em segundos
  postedAt     DateTime? // Quando foi postado na plataforma

  // Métricas atuais (última extração)
  views           BigInt  @default(0)
  likes           Int     @default(0)
  comments        Int     @default(0)
  shares          Int     @default(0)
  saves           Int? // Instagram
  socialAccountId String?

  // Localização
  locationId   String? // ID da localização
  locationName String? // Nome da localização
  locationSlug String? // Slug da localização
  locationLat  Float? // Latitude
  locationLng  Float? // Longitude

  // Status e validação
  status              ClipPostStatus @default(PENDING)
  eligibilityChecks   Json? // Resultado de cada validação
  ineligibilityReason String?

  // Flags de validação
  hasDuplicates       Boolean  @default(false)
  hasRequiredHashtags Boolean?
  hasRequiredMentions Boolean?
  isInDateRange       Boolean?
  isPublicProfile     Boolean?

  // Metadados
  lastMetricsUpdate DateTime? // Última vez que métricas foram atualizadas
  metadata          Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relações
  campaign                  Campaign                           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  application               ClipperApplication                 @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  socialAccount             SocialAccount?                     @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  metricsHistory            ClipPostMetrics[] // Histórico de métricas
  fraudFlags                FraudFlag[]
  dailyRankingEntries       DailyRankingEntry[] // Entradas em rankings diários
  metricsExtractionFailures MetricsExtractionFailure[]
  metricsExtractionRunItems CampaignMetricsExtractionRunItem[]
  bucketVideo               ClipPostBucketVideo?
  youtubeAnalytics          YouTubeVideoAnalytics[]
  originalVideoSearches     OriginalVideoSearch[]
  commentsData              ClipPostComment[]
  commentAnalysisJobs       CommentAnalysisJob[]
  commentAnalysisJobItems   CommentAnalysisJobItem[]
  commentAnalysisAggregates CommentAnalysisAggregate[]

  @@unique([campaignId, platformVideoId, platform])
  @@index([campaignId])
  @@index([applicationId])
  @@index([socialAccountId])
  @@index([platform])
  @@index([status])
  @@index([username])
  @@index([postedAt])
  @@index([createdAt])
  @@index([lastMetricsUpdate])
  @@index([campaignId, status]) // Contagens/filtros frequentes por campanha+status
  @@index([campaignId, status, lastMetricsUpdate, id]) // Descoberta de posts para atualização de métricas
  @@index([campaignId, createdAt, id]) // Jobs diários por campanha e data de criação
  @@index([applicationId, status]) // Queries por application+ELIGIBLE
}

model ClipPostComment {
  id String @id @default(cuid())

  clipPostId        String
  platform          Platform
  platformCommentId String
  platformVideoId   String?

  parentCommentId String?
  parentComment   ClipPostComment?  @relation("ClipPostCommentReplies", fields: [parentCommentId], references: [id], onDelete: SetNull)
  replies         ClipPostComment[] @relation("ClipPostCommentReplies")

  text              String    @db.Text
  textHash          String?
  username          String?
  displayName       String?
  authorChannelId   String?
  createdAtPlatform DateTime?
  likes             Int       @default(0)
  replyCount        Int       @default(0)
  source            String
  raw               Json?
  lastSyncAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clipPost         ClipPost                 @relation(fields: [clipPostId], references: [id], onDelete: Cascade)
  analyses         CommentAnalysisResult[]
  analysisJobItems CommentAnalysisJobItem[]

  @@unique([clipPostId, platform, platformCommentId])
  @@index([clipPostId])
  @@index([clipPostId, likes, createdAtPlatform, createdAt])
  @@index([textHash])
  @@index([platformVideoId])
  @@index([parentCommentId])
  @@index([createdAtPlatform])
}

model CommentAnalysisJob {
  id                          String                   @id @default(cuid())
  scope                       CommentAnalysisScope
  status                      CommentAnalysisJobStatus @default(PENDING)
  campaignId                  String?
  clipPostId                  String?
  requestedByUserId           String?
  requestedByUserEmail        String?
  forceReprocess              Boolean                  @default(false)
  promptVersion               String
  classifierModel             String
  summarizerModel             String?
  embeddingModel              String?
  totalComments               Int                      @default(0)
  queuedComments              Int                      @default(0)
  processedComments           Int                      @default(0)
  skippedComments             Int                      @default(0)
  failedComments              Int                      @default(0)
  inputTokens                 Int                      @default(0)
  outputTokens                Int                      @default(0)
  classifierInputTokens       Int                      @default(0)
  classifierCachedInputTokens Int                      @default(0)
  classifierOutputTokens      Int                      @default(0)
  summarizerInputTokens       Int                      @default(0)
  summarizerCachedInputTokens Int                      @default(0)
  summarizerOutputTokens      Int                      @default(0)
  embeddingInputTokens        Int                      @default(0)
  estimatedCostUsd            Float?
  actualCostUsd               Float?
  startedAt                   DateTime?
  completedAt                 DateTime?
  lastProgressAt              DateTime                 @default(now())
  errorMessage                String?                  @db.Text
  metadata                    Json?
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @updatedAt

  campaign Campaign?                @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  clipPost ClipPost?                @relation(fields: [clipPostId], references: [id], onDelete: SetNull)
  items    CommentAnalysisJobItem[]

  @@index([scope, status])
  @@index([campaignId, status])
  @@index([clipPostId, status])
  @@index([createdAt])
}

model CommentAnalysisJobItem {
  id             String                    @id @default(cuid())
  jobId          String
  commentId      String
  clipPostId     String
  campaignId     String
  status         CommentAnalysisItemStatus @default(PENDING)
  skippedReason  String?
  attemptsMade   Int                       @default(0)
  batchRequestId String?
  errorMessage   String?                   @db.Text
  startedAt      DateTime?
  completedAt    DateTime?
  metadata       Json?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  job      CommentAnalysisJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  comment  ClipPostComment    @relation(fields: [commentId], references: [id], onDelete: Cascade)
  clipPost ClipPost           @relation(fields: [clipPostId], references: [id], onDelete: Cascade)

  @@unique([jobId, commentId])
  @@index([jobId, status])
  @@index([jobId, status, attemptsMade, createdAt])
  @@index([jobId, batchRequestId])
  @@index([commentId])
  @@index([clipPostId])
  @@index([campaignId])
}

model CommentAnalysisResult {
  id                         String   @id @default(cuid())
  commentId                  String
  clipPostId                 String
  campaignId                 String
  platform                   Platform
  textHash                   String
  normalizedText             String   @db.Text
  language                   String?
  sentiment                  String
  sentimentScore             Float
  opinionTypes               String[] @default([])
  intensity                  String
  tones                      String[] @default([])
  topics                     String[] @default([])
