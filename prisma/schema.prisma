// ============================================================================
// VÍDEOS BRUTOS & CORTES POR COMPETIÇÃO
// ============================================================================

model RawVideo {
  id         String @id @default(cuid())
  campaignId String

  title       String?
  description String?

  // URL do arquivo bruto armazenado no Google Cloud Storage
  storageUrl String

  // URL original da rede social onde o vídeo foi publicado (opcional)
  originalUrl String?

  // Metadados do arquivo
  fileSize  BigInt? // Tamanho em bytes
  duration  Int? // Duração em segundos
  mimeType  String? // ex: "video/mp4"
  thumbnail String? // URL da thumbnail no GCS

  // ── Análise qualitativa (preenchido por AI) ──
  transcription String?      @db.Text
  language      String? // Idioma detectado, ex: "pt-BR", "en-US"
  niches        VideoNiche[] // Lista de nichos padronizada
  tags          String[] // Tags / palavras-chave relevantes
  sentiment     String? // Sentimento geral: "positive", "negative", "neutral", "mixed"
  topics        String[] // Tópicos / assuntos abordados
  summary       String?      @db.Text // Resumo gerado por AI

  // Métricas qualitativas (0–100)
  qualityScore    Float? // Nota geral de qualidade do conteúdo
  engagementScore Float? // Potencial de engajamento estimado
  viralityScore   Float? // Potencial de viralização estimado

  // Metadados da análise
  aiModel       String? // Modelo de AI utilizado, ex: "gpt-4o", "gemini-1.5"
  analyzedAt    DateTime? // Data/hora em que a análise foi feita
  analysisNotes String?   @db.Text // Observações extras da análise

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  campaign Campaign       @relation("CampaignRawVideos", fields: [campaignId], references: [id], onDelete: Cascade)
  clips    RawVideoClip[]

  @@index([campaignId])
}

enum OriginalVideoSearchStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

model OriginalVideoCandidate {
  id           String  @id
  searchId     String
  transcriptId String?

  url      String
  platform Platform
  videoId  String?

  title        String?
  channelTitle String?
  duration     Int?

  rank           Int
  searchProvider String
  query          String

  textScore     Float @default(0)
  fuzzyScore    Float @default(0)
  durationScore Float @default(0)
  metadataScore Float @default(0)
  finalScore    Float @default(0)

  matchedStart Float?
  matchedEnd   Float?
  matchedText  String?
  method       String?

  metadata  Json?
  createdAt DateTime @default(now())

  originalVideoSearch OriginalVideoSearch @relation(fields: [searchId], references: [id], onDelete: Cascade)
  videoTranscript     VideoTranscript?    @relation(fields: [transcriptId], references: [id], onDelete: NoAction)

  @@index([finalScore])
  @@index([searchId])
  @@index([transcriptId])
  @@index([videoId])
}

model OriginalVideoSearch {
  id               String                    @id
  clipPostId       String?
  inputUrl         String
  status           OriginalVideoSearchStatus @default(QUEUED)
  clipTranscriptId String?

  queries            String[] @default([])
  candidatesAnalyzed Int      @default(0)

  matched          Boolean @default(false)
  originalVideoUrl String?
  originalVideoId  String?
  confidence       Float?
  startTime        Float?
  endTime          Float?
  matchedText      String?
  method           String?

  errorMessage String?
  metadata     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime
  completedAt  DateTime?

  originalVideoCandidates OriginalVideoCandidate[]
  clipPost                ClipPost?                @relation(fields: [clipPostId], references: [id], onDelete: Cascade)
  videoTranscript         VideoTranscript?         @relation(fields: [clipTranscriptId], references: [id], onDelete: NoAction)

  @@index([clipPostId])
  @@index([createdAt])
  @@index([status])
}

model VideoTranscript {
  id       String   @id
  platform Platform
  videoId  String?
  url      String

  title        String?
  channelTitle String?
  channelId    String?
  duration     Int?
  language     String?

  segments       Json
  normalizedText String
  source         String
  provider       String
  textHash       String

  fetchedAt DateTime  @default(now())
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime

  originalVideoCandidates OriginalVideoCandidate[]
  originalVideoSearches   OriginalVideoSearch[]

  @@unique([platform, videoId, provider])
  @@index([expiresAt])
  @@index([textHash])
  @@index([url])
  @@index([videoId])
}

model RawVideoClip {
  id         String @id @default(cuid())
  rawVideoId String

  title String?

  // URL do corte armazenado no Google Cloud Storage
  storageUrl String

  // Timestamps do trecho no vídeo original (em segundos)
  startTime Float?
  endTime   Float?

  // Metadados do arquivo
  fileSize  BigInt? // Tamanho em bytes
  duration  Int? // Duração em segundos
  mimeType  String? // ex: "video/mp4"
  thumbnail String? // URL da thumbnail no GCS

  // ── Análise qualitativa (preenchido por AI) ──
  transcription String?      @db.Text
  language      String? // Idioma detectado
  niches        VideoNiche[] // Lista de nichos padronizada
  tags          String[] // Tags / palavras-chave relevantes
  sentiment     String? // Sentimento geral: "positive", "negative", "neutral", "mixed"
  topics        String[] // Tópicos / assuntos abordados
  summary       String?      @db.Text // Resumo gerado por AI

  // Métricas qualitativas (0–100)
  qualityScore    Float? // Nota geral de qualidade do corte
  engagementScore Float? // Potencial de engajamento estimado
  viralityScore   Float? // Potencial de viralização estimado

  // Contexto do corte
  hookType    String? // Tipo de hook usado, ex: "question", "shock", "statement"
  cta         String? // Call-to-action identificado
  contentType String? // Tipo de conteúdo, ex: "tutorial", "react", "storytime", "challenge"

  // Metadados da análise
  aiModel       String? // Modelo de AI utilizado
  analyzedAt    DateTime? // Data/hora em que a análise foi feita
  analysisNotes String?   @db.Text // Observações extras da análise

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  rawVideo RawVideo @relation(fields: [rawVideoId], references: [id], onDelete: Cascade)

  @@index([rawVideoId])
}

enum YouTubeShopAuthStatus {
  PENDING
  ACTIVE
  EXPIRED
  REVOKED
  ERROR
}

model YouTubeShopAuth {
  id             String @id @default(cuid())
  organizationId String

  merchantId   String
  merchantName String?

  accessToken  String
  refreshToken String?
  tokenType    String   @default("Bearer")
  scope        String
  expiresAt    DateTime

  status       YouTubeShopAuthStatus @default(PENDING)
  lastSyncAt   DateTime?
  errorMessage String?
  metadata     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization        Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creatorPerformances YouTubeShopCreatorPerformance[]
  videoPerformances   YouTubeShopVideoPerformance[]
  syncLogs            YouTubeShopSyncLog[]

  @@unique([organizationId, merchantId])
  @@index([organizationId])
  @@index([merchantId])
  @@index([status])
  @@index([expiresAt])
}

model YouTubeShopCreatorPerformance {
  id                String @id @default(cuid())
  youtubeShopAuthId String

  date DateTime @db.Date

  channelId    String
  channelTitle String?

  grossSalesMicros  BigInt @default(0)
  netSalesMicros    BigInt @default(0)
  commissionsMicros BigInt @default(0)
  currencyCode      String @default("BRL")

  orders Int    @default(0)
  views  BigInt @default(0)
  clicks Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  youtubeShopAuth YouTubeShopAuth @relation(fields: [youtubeShopAuthId], references: [id], onDelete: Cascade)

  @@unique([youtubeShopAuthId, date, channelId])
  @@index([youtubeShopAuthId])
  @@index([channelId])
  @@index([date])
}

model YouTubeShopVideoPerformance {
  id                String @id @default(cuid())
  youtubeShopAuthId String

  date DateTime @db.Date

  videoId      String
  videoTitle   String?
  channelId    String
  channelTitle String?

  taggedProductIds String[]

  grossSalesMicros  BigInt @default(0)
  netSalesMicros    BigInt @default(0)
  commissionsMicros BigInt @default(0)
  currencyCode      String @default("BRL")

  orders Int    @default(0)
  views  BigInt @default(0)
  clicks Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  youtubeShopAuth YouTubeShopAuth @relation(fields: [youtubeShopAuthId], references: [id], onDelete: Cascade)

  @@unique([youtubeShopAuthId, date, videoId])
  @@index([youtubeShopAuthId])
  @@index([videoId])
  @@index([channelId])
  @@index([date])
}

enum YouTubeShopSyncStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  PARTIAL
}

model YouTubeShopSyncLog {
  id                String                @id @default(cuid())
  youtubeShopAuthId String
  status            YouTubeShopSyncStatus @default(PENDING)
  syncType          String

  dateFrom DateTime?
  dateTo   DateTime?

  recordsProcessed Int @default(0)
  recordsCreated   Int @default(0)
  recordsUpdated   Int @default(0)
  recordsFailed    Int @default(0)

  startedAt   DateTime?
  completedAt DateTime?
  duration    Int?

  errorMessage String?
  errorDetails Json?
  logs         Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  youtubeShopAuth YouTubeShopAuth @relation(fields: [youtubeShopAuthId], references: [id], onDelete: Cascade)

  @@index([youtubeShopAuthId])
  @@index([status])
  @@index([syncType])
  @@index([createdAt])
}

model InstagramAuth {
  id              String @id @default(cuid())
  socialAccountId String @unique

  accessToken String   @db.Text
  tokenType   String   @default("Bearer")
  scope       String?
  expiresAt   DateTime

  igUserId          String
  username          String
  accountType       String
  profilePictureUrl String?
  followersCount    Int?
  mediaCount        Int?
  biography         String?
  website           String?

  isActive   Boolean             @default(true)
  status     InstagramAuthStatus @default(PENDING)
  lastSyncAt DateTime?
  lastError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  socialAccount       SocialAccount                  @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  hashtagTracking     InstagramHashtagTracking[]
  mediaAnalytics      InstagramMediaAnalytics[]
  accountDemographics InstagramAccountDemographics[]
  comments            InstagramComment[]
  syncLogs            InstagramSyncLog[]

  @@index([socialAccountId])
  @@index([igUserId])
  @@index([isActive])
  @@index([status])
  @@index([expiresAt])
  @@index([username])
}

model InstagramSyncLog {
  id              String              @id @default(cuid())
  instagramAuthId String
  status          InstagramSyncStatus @default(PENDING)

  videosProcessed Int @default(0)
  videosUpdated   Int @default(0)
  videosFailed    Int @default(0)
  commentsFetched Int @default(0)
  commentsNew     Int @default(0)

  startedAt   DateTime?
  completedAt DateTime?
  duration    Int?

  errorMessage String?
  errorDetails Json?
  logs         Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  instagramAuth InstagramAuth @relation(fields: [instagramAuthId], references: [id], onDelete: Cascade)

  @@index([instagramAuthId])
  @@index([status])
  @@index([createdAt])
}

model InstagramHashtagTracking {
  id              String @id @default(cuid())
  instagramAuthId String

  hashtag   String
  hashtagId String?

  isActive    Boolean @default(true)
  trackRecent Boolean @default(true)
  trackTop    Boolean @default(false)

  lastCheckedAt   DateTime?
  totalMediaFound Int       @default(0)
  lastMediaId     String?

  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  instagramAuth  InstagramAuth             @relation(fields: [instagramAuthId], references: [id], onDelete: Cascade)
  mediaAnalytics InstagramMediaAnalytics[]

  @@unique([instagramAuthId, hashtag])
  @@index([instagramAuthId])
  @@index([hashtag])
  @@index([isActive])
  @@index([lastCheckedAt])
}

model InstagramMediaAnalytics {
  id                String  @id @default(cuid())
  instagramAuthId   String
  hashtagTrackingId String?

  igMediaId        String
  mediaType        String
  mediaProductType String?
  permalink        String
  caption          String?  @db.Text
  timestamp        DateTime

  date       DateTime @db.Date
  views      Int      @default(0)
  likes      Int      @default(0)
  comments   Int      @default(0)
  saved      Int      @default(0)
  shares     Int      @default(0)
  engagement Int      @default(0)
  reach      Int      @default(0)
  plays      Int      @default(0)

  engagementRate Float?

  profileActivity Int?
  profileVisits   Int?
  follows         Int?

  thumbnailUrl  String?
  mediaUrl      String?
  videoDuration Int?
  isVideo       Boolean @default(false)

  isActive   Boolean   @default(true)
  lastSyncAt DateTime?
  syncError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  instagramAuth   InstagramAuth             @relation(fields: [instagramAuthId], references: [id], onDelete: Cascade)
  hashtagTracking InstagramHashtagTracking? @relation(fields: [hashtagTrackingId], references: [id], onDelete: SetNull)

  @@unique([igMediaId, date])
  @@index([instagramAuthId])
  @@index([hashtagTrackingId])
  @@index([date])
  @@index([igMediaId])
  @@index([timestamp])
  @@index([mediaType])
}

model InstagramAccountDemographics {
  id              String @id @default(cuid())
  instagramAuthId String

  date       DateTime @db.Date
  timeframe  String
  metricType String

  countryData   Json
  cityData      Json
  ageGenderData Json

  totalValue Int?

  createdAt DateTime @default(now())

  instagramAuth InstagramAuth @relation(fields: [instagramAuthId], references: [id], onDelete: Cascade)

  @@unique([instagramAuthId, date, timeframe, metricType])
  @@index([instagramAuthId])
  @@index([date])
  @@index([timeframe])
}

model InstagramComment {
  id              String @id @default(cuid())
  instagramAuthId String

  igCommentId String @unique
  igMediaId   String

  text      String   @db.Text
  timestamp DateTime
  username  String?
  likeCount Int      @default(0)
  hidden    Boolean  @default(false)

  parentCommentId String?
  parentComment   InstagramComment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: SetNull)
  replies         InstagramComment[] @relation("CommentReplies")

  sentimentScore Float?
  sentimentLabel String?
  analyzedAt     DateTime?

  mediaPermalink String?
  isActive       Boolean   @default(true)
  lastSyncAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  instagramAuth InstagramAuth @relation(fields: [instagramAuthId], references: [id], onDelete: Cascade)

  @@index([instagramAuthId])
  @@index([igMediaId])
  @@index([igCommentId])
  @@index([parentCommentId])
  @@index([timestamp])
  @@index([sentimentLabel])
  @@index([username])
}
