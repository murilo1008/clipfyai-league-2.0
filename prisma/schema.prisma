model ClipPostMetrics {
  id          String   @id @default(cuid())
  clipPostId  String
  collectedAt DateTime @default(now())

  // Métricas extraídas
  views    BigInt @default(0)
  likes    Int    @default(0)
  comments Int    @default(0)
  shares   Int    @default(0)
  saves    Int? // Instagram

  // Métricas derivadas (calculadas no momento da coleta)
  engagementRate Float? // (likes + comments + shares + saves) / views * 100
  velocity24h    Float? // Taxa de crescimento nas últimas 24h
  velocity48h    Float? // Taxa de crescimento nas últimas 48h

  // Deltas desde última coleta
  viewsDelta    BigInt? // Diferença de views
  likesDelta    Int? // Diferença de likes
  commentsDelta Int? // Diferença de comentários
  sharesDelta   Int? // Diferença de compartilhamentos
  savesDelta    Int? // Diferença de salvamentos

  // Metadados
  metadata  Json?
  createdAt DateTime @default(now())

  // Relações
  clipPost ClipPost @relation(fields: [clipPostId], references: [id], onDelete: Cascade)

  @@index([clipPostId, collectedAt])
  @@index([collectedAt])
}

