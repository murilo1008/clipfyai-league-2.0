# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly. 

# Prisma
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env 
DATABASE_URL="postgresql://postgres:password@localhost:5432/league-clipfyai"

# Integração com o backend da League
# LEAGUE_API_URL: URL base desta aplicação, usada nas chamadas internas (jobs/webhooks).
# LEAGUE_INTERNAL_API_KEY: chave compartilhada que autentica as rotas internas.
# Sem a chave, as rotas internas recusam a requisição (fail-closed).
LEAGUE_API_URL=http://localhost:3000
LEAGUE_INTERNAL_API_KEY=replace-with-internal-api-key

# Serviço de pagamentos diários (daily payout)
# DAILY_PAYOUT_BASE_URL: URL base do serviço que executa os pagamentos.
# DAILY_PAYOUT_INTERNAL_KEY: chave de autenticação desse serviço.
# Se qualquer uma faltar, o cliente de pagamento é desativado.
DAILY_PAYOUT_BASE_URL=http://localhost:3000
DAILY_PAYOUT_INTERNAL_KEY=replace-with-daily-payout-internal-key

# Janela (em dias) que a sincronização de links do YouTube olha para trás
# ao buscar vídeos publicados. Padrão: 30.
YOUTUBE_LINK_SYNC_LOOKBACK_DAYS=30

# Allowlist de rollout da extração manual de métricas
# IDs de usuário separados por vírgula. Vazio = extração manual bloqueada/oculta para todos.
MANUAL_METRICS_EXTRACTION_ALLOWED_USER_IDS=user_123,user_456

# Allowlist de rollout das integrações sociais oficiais (YouTube, Instagram, TikTok)
# IDs de usuário e/ou e-mails separados por vírgula.
# Ambas vazias = integrações sociais bloqueadas/ocultas para todos.
SOCIAL_INTEGRATIONS_ALLOWED_USER_IDS=user_123,user_456
SOCIAL_INTEGRATIONS_ALLOWED_EMAILS=creator@example.com,admin@example.com
